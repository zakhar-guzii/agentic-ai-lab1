# Keys: fill in both. No defaults; the values stay only in .env, which git ignores.
# OpenRouter key for the agent's model (carpathian-agent).
OPENROUTER_API_KEY=
# OpenWeatherMap key, passed to the Weather MCP process (carpathian-agent, carpathian-weather-probe).
OWM_API_KEY=

# Settings: the values below are the defaults the code uses; change them only if needed.
# Agent model, openrouter:<id>. An empty value also means this default.
MODEL=openrouter:anthropic/claude-haiku-5.5
# Address of the trails server for the agent. An empty value also means this default.
TRAILS_MCP_URL=http://127.0.0.1:8765/mcp
# Command that starts Weather MCP over stdio. Must not be empty.
WEATHER_MCP_COMMAND="docker run -i --rm --pull=never -e OWM_API_KEY mcp-weather"
# Seconds to wait for Weather MCP (startup and each call); a positive number. Must not be empty.
WEATHER_TIMEOUT_S=20
